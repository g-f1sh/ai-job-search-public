# Generate a long random value, for example: openssl rand -base64 36
PORTAL_AUTH_TOKEN=replace-with-a-long-random-secret

# Set to 1 for the HTTPS hostname. Keep 0 only for direct localhost testing.
PORTAL_COOKIE_SECURE=1

# The portal uses the existing `codex login` session owned by this Linux user.
CODEX_BIN=/home/jobsearch/.nvm/versions/node/v22.23.1/bin/codex

# Availability-only refresh defaults (preview can explicitly override per batch).
PORTAL_REFRESH_FRESHNESS_HOURS=24
PORTAL_REFRESH_BATCH_SIZE=10
# Number of postings allowed AI interpretation, not a hard token/cost cap. 0 disables AI.
PORTAL_REFRESH_MAX_AI_FALLBACKS=2
PORTAL_CV_CONCURRENCY=2
PORTAL_REFRESH_HTTP_TIMEOUT=8
PORTAL_REFRESH_CACHE_SECONDS=21600
PORTAL_REFRESH_RATE_SECONDS=1
